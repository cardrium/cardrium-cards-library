        }
      },
      "description": "列表组件绑定。items 每项：title（必填）、url、subtitle、badge、meta、source、_unverified；header 为顶部一行摘要；errors 为可展开的失败明细 [{ url, message }]（如 RSS 源读取失败，附“配置代理”入口）。"
    },
    "textBind": {
      "type": "object",
      "required": [
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/bindValue"
        },
        "citations": {
          "$ref": "#/$defs/bindArray"
        },
        "footer": {
          "$ref": "#/$defs/bindValue"
        },
        "status": {
          "$ref": "#/$defs/bindValue"
        },
        "link": {
          "$ref": "#/$defs/bindValue"
        }
      },
      "description": "文本组件绑定。citations 每项 { title, url }，显示在底部“来源”区；footer 为底部一行小字。"
    },
    "chartBind": {
      "type": "object",
      "required": [
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "series": {
          "$ref": "#/$defs/bindArray"
        },
        "headline": {
          "$ref": "#/$defs/bindValue"
        },
        "status": {
          "$ref": "#/$defs/bindValue"
        },
        "link": {
          "$ref": "#/$defs/bindValue"
        }
      },
      "description": "图表组件绑定。series: [{ name, data: [{ x, y }] }]；饼图只取第一组，x 为分类名；headline 为图表上方一行摘要。"
    },
    "todoBind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "$ref": "#/$defs/bindArray"
        },
        "header": {
          "$ref": "#/$defs/bindValue"
        },
        "status": {
          "$ref": "#/$defs/bindValue"
        },
        "link": {
          "$ref": "#/$defs/bindValue"
        }
      },
      "description": "待办组件绑定。items 每项：id（必填，用于回写）、text（必填）、done、due、priority（high|normal|low）、note，以及 options.badgeField 指定的字段；省略 items 时组件直接显示 storageKey 里的列表。"
    },
    "display": {
      "type": "object",
      "required": [
        "component",
        "size"
      ],
      "properties": {
        "component": {
          "enum": [
            "number",
            "list",
            "text",
            "chart",
            "todo"
          ]
        },
        "options": {
          "type": "object"
        },
        "size": {
          "$ref": "#/$defs/gridSize",
          "description": "默认占用网格。"
        },
        "minSize": {
          "$ref": "#/$defs/gridSize"
        },
        "title": {
          "type": "string",
          "maxLength": 40,
          "description": "卡片标题，缺省用 meta.name。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "component": {
                "const": "number"
              }
            },
            "required": [
              "component"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/numberOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "component": {
                "const": "list"
              }
            },
            "required": [
              "component"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/listOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "component": {
                "const": "text"
              }
            },
            "required": [
              "component"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "$ref": "#/$defs/textOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "component": {
                "const": "chart"
              }
            },
            "required": [
              "component"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "$ref": "#/$defs/chartOptions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "component": {
                "const": "todo"
              }
            },
            "required": [
              "component"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "$ref": "#/$defs/todoOptions"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "numberOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compact": {
          "type": "boolean",
          "description": "≥10000 时缩写（1.2 万 / 12.3k），缺省 true。"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "缺省 2。"
        },
        "invertColors": {
          "type": "boolean",
          "description": "变化量颜色反转（如错误数增加是坏事）。"
        }
      }
    },
    "listOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "缺省 10，其余折叠为“还有 N 条”。"
        },
        "showIndex": {
          "type": "boolean"
        },
        "emptyText": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "textOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "plain",
            "markdown"
          ],
          "description": "缺省 plain；markdown 按白名单渲染（不渲染图片、HTML、表格）。"
        },
        "emptyText": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "chartOptions": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "line",
            "bar",
            "pie"
          ]
        },
        "stacked": {
          "type": "boolean"
        },
        "xType": {
          "enum": [
            "category",
            "time"
          ]
        },
        "yUnit": {
          "type": "string",
          "maxLength": 10
        },
        "emptyText": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "todoOptions": {
      "type": "object",
      "required": [
        "storageKey"
      ],
      "additionalProperties": false,
      "properties": {
        "storageKey": {
          "$ref": "#/$defs/storageKey",
          "description": "用户勾选/新增/编辑/删除的结果由平台直接写回本卡片存储的这个键（需 permissions.storage），不经过工作流。"
        },
        "itemsPath": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,39}$",
          "description": "存储值里待办数组所在的字段（如 \"items\"）；省略表示存储值本身就是数组。"
        },
        "allowAdd": {
          "type": "boolean"
        },
        "allowDelete": {
          "type": "boolean"
        },
        "allowEdit": {
          "type": "boolean"
        },
        "hideDoneAfterDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365,
          "description": "缺省 1。"
        },
        "rerunOnChange": {
          "type": "boolean",
          "description": "用户改动待办后重新运行一次工作流（防抖 1 秒；触发来源记为 change；AI 步骤照常走 cacheKey，未命中缓存的调用照常计数）。缺省 false。"
        },
        "badgeField": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,39}$",
          "description": "每项右侧小标签取自该字段（如 units → “+1”）。"
        },
        "emptyText": {
          "type": "string",
          "maxLength": 100
        }
      }
    }
  }
}
