        },
        "days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            },
            {
              "$ref": "#/$defs/wholeRef"
            }
          ],
          "description": "scope=platform.usage：汇总最近几天，缺省 7。整数，或整值引用一个参数（运行时转整数并限制在 1–90）。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
