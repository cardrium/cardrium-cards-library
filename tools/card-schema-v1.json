              "op": {
                "const": "get"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "key"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "maxLength"
                  ]
                },
                {
                  "required": [
                    "uniqueBy"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "key"
            ],
            "not": {
              "required": [
                "days"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "get"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "maxLength"
                  ]
                },
                {
                  "required": [
                    "uniqueBy"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "set"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "maxLength"
                  ]
                },
                {
                  "required": [
                    "uniqueBy"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "append"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "delete"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
