              "anyOf": [
                {
                  "required": [
                    "value"
                  ]
                },
                {
                  "required": [
                    "default"
                  ]
                },
                {
                  "required": [
                    "maxLength"
                  ]
                },
                {
                  "required": [
                    "uniqueBy"
                  ]
                }
              ]
            }
          }
        }
      ],
      "description": "读写本卡片实例的键值存储。输出：get → 值（不存在时为 default 或 null）；set → 新值；append → 追加后的数组；delete → null。scope=platform.usage 时只能 get，返回平台 AI 用量汇总（需 permissions.usage）。"
    },
    "conditionStep": {
      "required": [
        "if",
        "then"
      ],
      "properties": {
        "if": {
          "$ref": "#/$defs/expr"
        },
        "then": {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "enum": [
                "stop",
                "skipTo",
