            "card",
            "platform.usage"
          ],
          "description": "缺省 card。"
        },
        "key": {
          "$ref": "#/$defs/storageKey"
        },
        "value": {
          "$ref": "#/$defs/anyJson"
        },
        "default": {
          "$ref": "#/$defs/anyJson"
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "append：最多保留条数，超出丢弃最早的。"
        },
        "uniqueBy": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,39}$",
