    "httpStep": {
      "required": [
        "url"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "url": {
          "$ref": "#/$defs/urlTemplate"
        },
        "headers": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          },
          "description": "值为模板字符串。v1 只允许 Accept、Accept-Language、Content-Type 三个请求头（语义校验），避免自定义头让预检失败（如 Google 预检遇到未知请求头返回 403），也避免写入凭据。"
        },
        "body": {
          "description": "POST 请求体，其中字符串按模板处理。对象和数组按 JSON 序列化，字符串原样作为请求体；缺省的 Content-Type 是 application/json（字符串 body 也一样，不再按文本发送）。schema v1.1 增量约束（文档第 15 节）：没写 Content-Type 时平台补 application/json，给警告 W_HTTP_CONTENT_TYPE_DEFAULTED；用 text/plain、application/x-www-form-urlencoded、multipart/form-data 报 E_HTTP_SIMPLE_CONTENT_TYPE，来源声明为 requires: \"proxy\" 也不例外；Content-Type 用模板报 E_HTTP_CONTENT_TYPE。运行时简单类型的请求只走代理，没有代理返回 PROXY_REQUIRED 并按 onProxyMissing 处理。"
        },
        "responseType": {
          "enum": [
            "auto",
            "json",
            "text"
          ],
          "description": "缺省 auto：按 Content-Type 判断。"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000,
          "description": "单个请求的总时长上限，缺省且最大 30000（HTTP 请求总时长 30 秒，技术负责人第二轮拍板 F4）。"
        },
        "allowNon2xx": {
          "type": "boolean",
          "description": "非 2xx 也视为成功（缺省 false）。"
        },
        "onProxyMissing": {
          "enum": [
            "notice",
            "fail"
          ],
          "description": "目标来源需要代理（网络条目 requires: \"proxy\"，或平台内置的“已知需代理域名”清单命中）而用户没有配置代理时怎么办。notice（缺省）：不发请求，本步输出 null（rss 为把这些源记入 errors，code=PROXY_REQUIRED），卡片顶部显示“此来源需要代理 · 去设置”，后续步骤继续；fail：本次运行失败并显示同样的提示。"
        }
      },
      "description": "HTTP 请求。输出 { status, headers, body }；body 为对象时其字段同时平铺到输出根部（status/headers/body 三个名字除外），所以 {{n1.stargazers_count}} 等价于 {{n1.body.stargazers_count}}。"
    },
    "rssStep": {
      "required": [
        "urls"
      ],
      "properties": {
        "urls": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "$ref": "#/$defs/urlTemplate"
              }
            },
            {
              "type": "string",
              "pattern": "^\\{\\{\\s*inputs\\.[a-z][A-Za-z0-9_]*\\s*\\}\\}$"
            }
          ],
          "description": "网址数组，或整值引用一个 url-list 参数（如 \"{{inputs.feeds}}\"）。"
        },
        "maxItemsPerFeed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "缺省 10。"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "合并后总数，缺省 20。"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 30000,
          "description": "每个源的请求总时长上限，缺省且最大 30000。"
        },
        "onProxyMissing": {
          "enum": [
            "notice",
            "fail"
          ],
          "description": "目标来源需要代理（网络条目 requires: \"proxy\"，或平台内置的“已知需代理域名”清单命中）而用户没有配置代理时怎么办。notice（缺省）：不发请求，本步输出 null（rss 为把这些源记入 errors，code=PROXY_REQUIRED），卡片顶部显示“此来源需要代理 · 去设置”，后续步骤继续；fail：本次运行失败并显示同样的提示。"
        }
      },
      "description": "拉取并解析 RSS 2.0 / Atom。输出 { items: [{ title, link, published, summary, source, feedUrl }], errors: [{ feedUrl, code, message }] }（code：PROXY_REQUIRED / NETWORK_ERROR（含跨域被拦）/ HTTP_ERROR / PARSE_ERROR / TIMEOUT）；单个源失败不影响其他源；多源按 published 倒序合并、按 link 去重；summary 为纯文本且 ≤300 字符。"
    },
    "modelSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": [
            "fast",
            "strong"
          ],
          "description": "缺省 fast。"
        },
        "needs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "json",
