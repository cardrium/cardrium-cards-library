{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:card-schema:v1",
  "title": "卡片定义 v1",
  "description": "卡片 = 元信息 + 权限声明 + 费用限制与预估 + 用户参数 + 工作流（触发 + 线性步骤）+ 展示配置。JSON Schema 只管结构；跨字段规则（网址是否已声明、引用是否存在、展示组件绑定是否完整等）由 card-validator 的语义校验负责，两者都通过才算合法卡片。",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "permissions",
    "inputs",
    "workflow",
    "display"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "可选，编辑器提示用，平台忽略。"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(\\.(0|[1-9][0-9]*))?$",
      "description": "schema 版本（字符串）：\"<主>\" 或 \"<主>.<次>\"，\"1\" 等同 \"1.0\"。主版本变化 = 不兼容；次版本 = 只加字段（旧卡片永远有效）。用到某次版本新增字段的卡片必须声明不低于该次版本；平台遇到高于自己支持的版本时拒绝导入并提示更新（语义校验 E_SCHEMA_VERSION）。当前平台支持到 1.0。"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "estimates": {
      "$ref": "#/$defs/estimates"
    },
    "inputs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/input"
      },
      "description": "导入后由用户填写的参数。模板里只放默认值，不放任何私有数据。"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    },
    "display": {
      "$ref": "#/$defs/display"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9_]{0,31}$",
      "description": "步骤 id / 参数 key：小写字母开头，字母数字下划线，≤32。步骤 id 不能是 inputs、run 及 JSONata 保留字（语义校验）。"
    },
    "template": {
      "type": "string",
      "maxLength": 30000,
      "description": "模板字符串，可含 {{引用}}。引用对象/数组时按 JSON 文本插入；引用不存在的字段插入空字符串并在运行日志警告。写字面量 {{ 用 \\{{。"
    },
    "wholeRef": {
      "type": "string",
      "pattern": "^\\{\\{\\s*[a-z][A-Za-z0-9_]*(?:\\.[A-Za-z_$][A-Za-z0-9_$\\-]*|\\[[0-9]+\\])*\\s*\\}\\}$",
      "description": "整值引用：字符串里只有一个 {{路径}}，取原始值（数组/对象/数字），不转成字符串。"
    },
    "expr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "JSONata 表达式（受限用法见说明文档）。根上下文为 { inputs, run, <步骤id>: 输出 }；在过滤条件等内层上下文里访问根用 $$，如 $$.run.today。"
    },
    "exprBinding": {
      "type": "object",
      "required": [
        "expr"
      ],
      "additionalProperties": false,
      "properties": {
        "expr": {
          "$ref": "#/$defs/expr"
        }
      },
      "description": "用表达式计算绑定值。"
    },
    "bindValue": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 5000
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/exprBinding"
        }
      ],
      "description": "绑定值：字面量、模板字符串（含 {{引用}}，整值引用保留原类型），或 { \"expr\": JSONata }。"
    },
    "bindArray": {
      "anyOf": [
        {
          "$ref": "#/$defs/wholeRef"
        },
        {
          "$ref": "#/$defs/exprBinding"
        }
      ],
      "description": "数组类绑定：整值引用或表达式。"
    },
    "anyJson": {
      "description": "任意 JSON；其中的字符串按模板处理。"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9._~:/?#\\[\\]@!$&()*+,;=%-]+$",
      "maxLength": 500,
      "description": "规范的 https 网址：只允许 RFC 3986 的 ASCII 字符（非 ASCII 请用 punycode / 百分号编码），不允许引号、尖括号、反引号、反斜杠、空白和花括号（安全测试 VAL-05）。语义校验再用 URL 解析检查主机和 userinfo。"
    },
    "storageKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$",
      "description": "键名：字母、数字、.、-、_，≤64。只能是字面量，便于静态分析。"
    },
    "networkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "$ref": "#/$defs/urlPattern"
        },
        "requires": {
          "enum": [
            "proxy"
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 100,
          "description": "给用户看的说明，如“36氪 RSS 不支持跨域”。"
        }
      },
      "description": "网络条目的对象写法，用于附加来源特性。requires: \"proxy\" 表示该来源已知不支持浏览器跨域（见 cors-matrix.md），必须经用户配置的代理访问：请求层直接走代理、不先试直连；未配置代理时按步骤的 onProxyMissing 降级，导入确认页标注“需代理”。"
    },
    "urlPattern": {
      "type": "string",
      "pattern": "^https://(?:\\*\\.)?(?:[a-z0-9](?:[a-z0-9\\-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9\\-]*[a-z0-9])?)*\\.?|\\[[0-9a-f:.]+\\])(?::[0-9]{1,5})?(?:/[^*?#\\s]*\\*?)?$",
      "maxLength": 300,
      "description": "网址模式：https + 主机 + 可选端口 + 可选路径前缀。* 只能在子域最左侧（https://*.example.com/…）或路径末尾（/repos/*）；不允许通配所有域名（*、https://*/* 等），子域通配规则：*.x 只有在 x 是可注册域名，并且公共后缀列表（含 PRIVATE 段）里没有任何以 .x 结尾的规则时才允许；x 也不能在动态 DNS / 内网穿透 / 免费托管的补充禁用名单里（*.github.com 可以；*.github.io、*.workers.dev、*.com.cn、*.amazonaws.com、*.core.windows.net、*.cpolar.top 不行；语义校验 E_NET_PATTERN_TOO_BROAD）；不写路径 = 该主机全部路径；路径不以 * 结尾 = 精确路径。主机须小写、IDN 用 punycode。只允许 https 和公网域名：本机、内网、链路本地地址、IP 字面量（含十进制/十六进制/八进制变形和 IPv4 映射的 IPv6）一律拒绝（语义校验）；本地服务（如 Ollama）只能在模型渠道里配置。"
    },
    "urlTemplate": {
      "type": "string",
      "pattern": "^(?:https://|\\{\\{)",
      "maxLength": 2000,
      "description": "请求网址。scheme 与主机必须是字面量；{{引用}} 只能出现在主机之后。唯一例外：整值引用一个在 permissions.network 中以 \"{{inputs.<key>}}\" 声明过的 url-list 参数。"
    },
    "gridSize": {
      "type": "object",
      "required": [
        "w",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "author",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
          "description": "模板标识（kebab-case）。同 id 视为同一模板，用于重复导入判断和以后的更新提示。实例 id 由平台另行生成。"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "作者名或 GitHub 用户名。"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$",
          "description": "模板版本，SemVer。"
        },
        "icon": {
          "type": "string",
          "pattern": "^(?:lucide:[a-z0-9-]{1,40}|[^\\s<>\"'/\\\\:]{1,8})$",
          "description": "emoji（≤8 个字符）或内置图标 lucide:<name>。不允许外链图片。"
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          }
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "模板内容语言，如 zh-CN。"
        },
        "license": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]{2,40}$",
          "description": "模板许可证（SPDX 标识）。缺省视为 MIT-0。"
        },
        "homepage": {
          "$ref": "#/$defs/httpsUrl"
        },
        "source": {
          "enum": [
            "human",
            "ai",
            "ai+human"
          ],
          "description": "来源标记：人工编写 / 一句话生成 / 生成后人工修改。"
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": [
        "network",
        "model",
        "storage",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/urlPattern"
              },
              {
                "type": "string",
                "pattern": "^\\{\\{\\s*inputs\\.[a-z][A-Za-z0-9_]*\\s*\\}\\}$"
              },
              {
                "$ref": "#/$defs/networkEntry"
              }
            ]
          },
          "description": "允许访问的网址模式；或 \"{{inputs.<key>}}\"，表示“用户在该 url-list 参数里填写的网址”（用户保存参数时逐个确认新域名）。未声明的一律拒绝。"
        },
        "model": {
          "type": "boolean",
          "description": "是否调用模型（含 AI 联网搜索与代码里的 model.call）。渠道与 Key 由平台决定，卡片永远拿不到。"
        },
        "storage": {
          "type": "boolean",
          "description": "是否读写本卡片实例的本地存储（含待办组件的回写）。"
        },
        "code": {
          "type": "boolean",
          "description": "是否含代码步骤。true 时导入标红。"
        },
        "usage": {
          "type": "boolean",
          "description": "可选。是否只读平台 AI 用量汇总（storage 步骤 scope=platform.usage）。不含提示词与单次明细。"
        }
      },
      "description": "与 INTERFACE-CONTRACT.md 第 1 节一致。导入时逐项展示给用户确认；运行时平台据此放行或拒绝。"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelCallsPerRun": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "description": "一次运行最多调用模型几次（联网搜索、JSON 修复重试、代码步骤里的 model.call 都算），超出即 QUOTA_EXCEEDED。0 = 卡片从不调用模型：导入页显示“不使用 AI、不消耗额度”，没有配置任何 Key 也能运行，运行时调用 model.call 一律 PERMISSION_DENIED。没有 AI 步骤且 permissions.model=false 时可省略（按 0）；有 AI 步骤或 permissions.model=true 时必填且 ≥1（语义校验）。"
        },
        "modelCallsPerDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "可选，本卡片每日模型调用上限。实际生效 = min(本值, 用户全局每日上限)。"
        }
      },
      "description": "运行时强制执行的上限。有模型调用时 modelCallsPerRun 必填（语义校验）。"
    },
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "searchCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "description": "作者给出的每次运行预估，用于导入确认页和参数页显示；卡片运行后平台用最近 5 次实际值覆盖。"
    },
    "input": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "type": {
          "enum": [
            "string",
            "text",
            "number",
            "boolean",
            "date",
            "select",
            "url-list"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "placeholder": {
          "type": "string",
          "maxLength": 100
        },
        "help": {
          "type": "string",
          "maxLength": 200
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "pattern": {
          "type": "string",
          "maxLength": 200,
          "description": "string 类型的格式校验正则（表单用，≤200 字符）。"
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "url-list 最多几行。"
        },
        "maxLines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "text 最多几行（如“每行一个关键词，最多 5 个”）。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "maxLength": 5000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "date"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "default": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "url-list"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/httpsUrl"
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "trigger",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/step"
          },
          "contains": {
            "type": "object",
            "properties": {
              "type": {
                "const": "output"
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 1,
          "maxContains": 1,
          "description": "线性步骤列表，从上到下顺序执行。有且只有一个 output 步骤，且必须是最后一步（位置由语义校验检查）。"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onOpen": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "required": [
                "skipIfFreshMinutes"
              ],
              "additionalProperties": false,
              "properties": {
                "skipIfFreshMinutes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10080
                }
              }
            },
            {
              "type": "object",
              "required": [
                "oncePerDay"
              ],
              "additionalProperties": false,
              "properties": {
                "oncePerDay": {
                  "const": true
                }
              }
            }
          ],
          "description": "打开站点或切到该看板时运行。true / false，或 { skipIfFreshMinutes: N }（距上次成功不足 N 分钟则只显示缓存），或 { oncePerDay: true }（本地日期内成功过就不再自动运行）。"
        },
        "manual": {
          "const": true,
          "description": "手动刷新按钮，始终开启，不允许关闭。可省略。"
        },
        "intervalMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440,
          "description": "页面开着且可见时的定时间隔。硬下限 5；调用模型 ≥15、联网搜索 ≥60（平台常量，低于时导入自动上调并提示）。"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "http",
            "rss",
            "ai",
            "ai_search",
            "transform",
            "code",
            "storage",
            "condition",
            "output"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 60,
          "description": "步骤显示名（编辑器）。"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "onError": {
          "enum": [
            "stop",
            "continue"
          ],
          "description": "stop：整次运行失败（默认）；continue：本步输出记为 null，记录错误，继续后续步骤。"
        },
        "disabled": {
